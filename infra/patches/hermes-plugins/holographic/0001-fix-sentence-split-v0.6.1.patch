From 1ab34896d2fe4e3b92966d085710c1cb7ea9cf32 Mon Sep 17 00:00:00 2001
From: gonshell <gonshell@users.noreply.github.com>
Date: Thu, 15 Oct 2026 23:31:16 +0800
Subject: [PATCH 1/2] local-patch 0001: sentence splitting for auto-extraction
 (CJK punctuation, version-safe dots)

Upstream _RE_SENTENCE split on any '.', cutting tokens like v1.18/e.g.
into fragments that never matched. CJK full-width stops were not sentence
ends at all, so Chinese messages arrived as one long run.
---
 __init__.py | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/__init__.py b/__init__.py
index 837579e..620afb3 100644
--- a/__init__.py
+++ b/__init__.py
@@ -98,7 +98,8 @@ FACT_FEEDBACK_SCHEMA = {
 }
 
 # Auto-extraction: (patterns, category) — preferences -> user_pref, decisions -> project. Matched per sentence; the
-# sentence is stored, not the whole message.
+# sentence is stored, not the whole message. Local patch 0001: sentence splitting (see _sentences). Local patch 0002:
+# Chinese preference/decision patterns below — upstream 0.6.1 matched English and Russian only.
 _EXTRACT_CATEGORIES = (
     ([re.compile(r'\bI\s+(?:prefer|like|love|use|want|need)\s+\S', re.IGNORECASE),
       re.compile(r'\bmy\s+(?:favorite|favourite|preferred|default)\s+\w+\s+is\s+\S', re.IGNORECASE),
@@ -110,7 +111,23 @@ _EXTRACT_CATEGORIES = (
       re.compile(r'(?:^|\s)мы\s+(?:решили|договорились|выбрали)\s+\S', re.IGNORECASE),
       re.compile(r'(?:^|\s)в\s+проекте\s+(?:используем|используется|нужен|нужна|нужно)\s+\S', re.IGNORECASE)], "project"),
 )
-_RE_SENTENCE = re.compile(r"[^.!?\n]+[.!?]?")
+# Local patch 0001: sentence ends. Upstream split on any '.', which cut tokens like "v1.18" or "e.g." into two
+# fragments that both failed the length/pattern filters. CJK full-width punctuation ends a sentence; a Latin .!?
+# ends a sentence only before whitespace or the end of the text. Newlines separate as well.
+_RE_SENTENCE_END = re.compile(r"(?:[。！？；]+|[.!?]+(?=\s|$)|\n+)")
+
+
+def _sentences(text: str):
+    """Split a user message into sentences for auto-extraction."""
+    start = 0
+    for match in _RE_SENTENCE_END.finditer(text):
+        segment = text[start:match.end()].strip()
+        if segment:
+            yield segment
+        start = match.end()
+    tail = text[start:].strip()
+    if tail:
+        yield tail
 _EXTRACT_MAX_CHARS = 300
 
 # What a fact must not be. Facts are injected into later prompts, so instructions and tool transcripts stored as
@@ -821,7 +838,7 @@ class HolographicMemoryProvider(MemoryProvider):
                 continue
             if not isinstance(content, str) or len(content) < 10:
                 continue
-            for sentence in (m.group(0).strip() for m in _RE_SENTENCE.finditer(content)):
+            for sentence in _sentences(content):
                 if len(sentence) < 10 or len(sentence) > _EXTRACT_MAX_CHARS or _fact_problem(sentence):
                     continue
                 for patterns, category in _EXTRACT_CATEGORIES:
